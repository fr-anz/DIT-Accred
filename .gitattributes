# Normalise line endings so Windows and macOS/Linux contributors stop seeing
# phantom "modified" files. Without this, core.autocrlf=true makes every file
# git touches look changed even when the content is identical.
#
# Text files are stored with LF in the repository and checked out with the
# platform's native endings.
* text=auto eol=lf

# Explicit for the file types in this project.
*.svelte  text eol=lf
*.ts      text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.svg     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Binary assets: never touch these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.mp4     binary
*.webm    binary
*.pdf     binary
